#! /bin/sh
# Doors startup script (ported from ~/.config/bspwm/bspwmrc and ~/.config/river/init)

# Environment for apps launched from Doors
doorsctl env set XDG_CURRENT_DESKTOP doors:wlroots
doorsctl env set XDG_SESSION_TYPE wayland
doorsctl env set MOZ_ENABLE_WAYLAND 1
doorsctl env set _JAVA_AWT_WM_NONREPARENTING 1
doorsctl env set PATH "$PATH:$HOME/.local/bin"

# Screensharing / portals
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=doors:wlroots
systemctl --user restart xdg-desktop-portal

# Desktops
doorsctl output HDMI-A-1 -d I II III IV V VI VII VIII IX X

# Keyboard (us/ru, caps and escape swapped)
doorsctl input type:keyboard xkb_layout us,ru
doorsctl input type:keyboard xkb_options grp:ralt_rshift_toggle,caps:swapescape
doorsctl input type:keyboard repeat_rate 66
doorsctl input type:keyboard repeat_delay 350
# touchpad (replaces install/macbook/50-synaptics.conf, tap to click: 1 finger left, 2 right, 3 middle)
doorsctl input type:touchpad tap enabled
doorsctl input type:touchpad tap_button_map lrm
doorsctl input type:touchpad dwt enabled

# Look
doorsctl config border_width 1
doorsctl config window_gap 10
doorsctl config split_ratio 0.50
# bspwm defaults (doors defaults to spiral / first_child, which rearranges the tree)
doorsctl config automatic_scheme longest_side
doorsctl config initial_polarity second_child
# Do not wrap focus around at the edges
doorsctl config focus_wrapping false
doorsctl config borderless_monocle true
doorsctl config gapless_monocle true
doorsctl config presel_feedback_color '#404040'
doorsctl config enable_animations false

# Border colors (same as river init: focused 93a1a1, unfocused 586e75)
doorsctl config focused_border_color '#93a1a1'
doorsctl config normal_border_color '#586e75'
doorsctl config active_border_color '#586e75'

# No window title bars
doorsctl config decoration_mode none

# Window rules (same apps/workspaces as river/init; desktops are matched by exact name, not ^N)
doorsctl rule -a firefox desktop=III follow=off
doorsctl rule -a chromium desktop=VI follow=off
doorsctl rule -a org.telegram.desktop desktop=IX follow=off
doorsctl rule -a Spotify desktop=X follow=off

# Idle
doorsctl config idle_timeout 0

# Daemons: started only if not already running, so this file can be re-run to reload it
# (no killall, it would also kill the same programs in another session, e.g. river;
# they exit on their own when the compositor goes away)
start() {
    pgrep -x -u "$USER" "$1" >/dev/null && return
    "$@" &
}

start swaybg -i /usr/share/backgrounds/archlinux/landscape.jpg
start waybar -c ~/.config/waybar/config-doors.jsonc
start kanshi
start gammastep
start dunst
start wl-paste --watch cliphist store
